# ─── Council Proxy Configuration ─────────────────────────────────────────
# Copy this file to `.env` and fill in your API keys.

# ─── Recommended: OpenRouter (single key for all council members) ────────
# OpenRouter aggregates 100+ models from xAI, OpenAI, Google, Alibaba, etc.
# A single OpenRouter API key can drive Grok, Qwen, Gemini, GPT, Claude, and more.
# Sign up: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-...

# ─── Optional: Direct Provider Keys (for Chairman / advanced users) ──────
# DeepSeek for Chairman (recommended — fast, cheap, strong on Chinese benchmarks).
# Direct connection bypasses OpenRouter routing which can have capacity issues
# under sustained 40s+ timeouts on V4 Flash.
# Sign up: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# ─── Storage Paths (optional, defaults shown) ────────────────────────────
# Council archive directory — one JSON file per turn, NNN.json format
# Used for #NNN reference lookup and skipped_members tracking
# Default: $HOME/.council-proxy/archive
# ARCHIVE_DIR=/var/lib/council-proxy/archive

# Search backend state file (TAVILY → EXA → SEARXNG_ONLY auto-switch)
# Updated by an external monitor (e.g., cron-driven) when quota/auth errors detected
# Default: $HOME/.council-proxy/search_state.json
# SEARCH_STATE_PATH=/var/lib/council-proxy/search_state.json

# ─── SearXNG Backend (optional) ──────────────────────────────────────────
# Local SearXNG instance for fallback/composite search.
# When state machine is in SEARXNG_ONLY mode, the proxy actively calls SearXNG
# and injects results into the user message (bypassing Router).
# SEARXNG_URL=http://127.0.0.1:8888
